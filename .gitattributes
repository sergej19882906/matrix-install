# Скрипты и конфиги должны оставаться с LF-окончаниями строк,
# иначе bash на Linux не запустится.
* text=auto eol=lf

*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.inc text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.example text eol=lf
LICENSE text eol=lf
