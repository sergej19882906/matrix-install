# ===========================================================================
#  Конфигурация Matrix-сервера
#  Скопируйте этот файл в matrix.env и правьте под свой сервер:
#      cp config/matrix.env.example config/matrix.env
#  Затем: sudo bash install.sh --reconfigure
#
#  Домены должны иметь A/AAAA-записи, указывающие на IP этого сервера.
# ===========================================================================

# --- Основной домен --------------------------------------------------------
# Все субдомены создаются автоматически от этого домена
BASE_DOMAIN="matrix.example.com"

# FQDN homeserver (server_name в Synapse). Обычно совпадает с BASE_DOMAIN
SERVER_NAME="matrix.example.com"

# --- Субдомены сервисов (при необходимости переопределите) -----------------
ELEMENT_DOMAIN="element.matrix.example.com"    # веб-клиент Element
MAS_DOMAIN="mas.matrix.example.com"            # Matrix Authentication Service
KEYCLOAK_DOMAIN="sso.matrix.example.com"       # Keycloak (OIDC/SSO)
ADMIN_DOMAIN="admin.matrix.example.com"        # панель администратора
GRAFANA_DOMAIN="grafana.matrix.example.com"    # Grafana (мониторинг)
TURN_DOMAIN="turn.matrix.example.com"          # TURN/STUN

# Apex-домен для /.well-known/matrix (необязательно, если не управляете им)
APEX_DOMAIN=""

# --- Администратор ---------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME="admin"
SYNAPSE_ADMIN_USERNAME="admin"

# 1 — разрешить свободную регистрацию, 0 — только приглашения/SSO
PUBLIC_REGISTRATION="0"

# --- Включение компонентов -------------------------------------------------
ENABLE_OIDC="1"         # нативный OIDC Synapse (SSO через Keycloak) — актуально
ENABLE_KEYCLOAK="1"     # Keycloak как OIDC/SSO-провайдер
ENABLE_MAS="0"          # legacy-режим MAS (задеприкейтирован, требует старого Synapse)
ENABLE_BRIDGES="1"      # мессенджерные мосты
ENABLE_IRC="1"          # IRC-мост
ENABLE_MONITORING="1"   # Prometheus + Grafana
ENABLE_TURN="1"         # coturn (TURN/STUN для звонков)
ENABLE_BACKUP="1"       # резервное копирование + таймер

# --- Мосты -----------------------------------------------------------------
# Telegram: получить api_id/api_hash на https://my.telegram.org
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Discord: токен приложения (https://discord.com/developers/applications)
DISCORD_TOKEN=""
DISCORD_BOT_NAME="discordbot"

# IRC
IRC_SERVER="irc.libera.chat"
IRC_PORT="6697"
IRC_NICK="matrixbridge"
IRC_CHANNEL="#matrix"
IRC_PASSWORD=""
IRC_REGISTER_NICK="true"

# --- Резервные копии в S3 (любой S3-совместимый: AWS, MinIO, Selectel...) ---
S3_ENDPOINT="https://s3.example.com"
S3_BUCKET="matrix-backups"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# Локальные бэкапы старше N дней удаляются
BACKUP_RETENTION_DAYS="14"

# Пароль шифрования бэкапов (AES-256). Пусто — без шифрования.
BACKUP_PASSPHRASE=""

# --- Версии образов --------------------------------------------------------
# Для продакшена зафиксируйте конкретные версии (см. changelog проектов).
SYNAPSE_VERSION="latest"
ELEMENT_VERSION="latest"
MAS_VERSION="latest"        # образ: ghcr.io/matrix-org/matrix-authentication-service
KEYCLOAK_VERSION="26.0"
COTURN_VERSION="4.6.3"
PROMETHEUS_VERSION="v2.54.1"
GRAFANA_VERSION="11.2.0"
NODE_EXPORTER_VERSION="v1.8.2"
POSTGRES_EXPORTER_VERSION="v0.16.0"
CADVISOR_VERSION="v0.49.1"
SYNAPSE_ADMIN_VERSION="latest"
MAUTRIX_TELEGRAM_VERSION="latest"
MAUTRIX_WHATSAPP_VERSION="latest"
MAUTRIX_SIGNAL_VERSION="latest"
MAUTRIX_DISCORD_VERSION="latest"
IRC_BRIDGE_VERSION="latest"
